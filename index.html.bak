            <div class="grid min-h-[34rem] items-center gap-4 px-6 pb-24 pt-10 sm:px-12 md:min-h-[30rem] md:grid-cols-2 md:gap-8 md:px-16 md:py-14 md:pb-20">

              <!-- [SLIDE – CỘT CHỮ BẮT ĐẦU] -->
