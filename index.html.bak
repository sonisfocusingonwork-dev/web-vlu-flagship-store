  <!-- [FOOTER – KẾT THÚC] -->

  <!-- Toast thông báo khi thêm vào giỏ -->
  <div id="toast" role="status" aria-live="polite" class="pointer-events-none fixed bottom-6 left-1/2 z-[60] max-w-[calc(100vw-2rem)] -translate-x-1/2 translate-y-4 rounded-full bg-ink px-5 py-3 text-sm font-semibold text-white opacity-0 shadow-xl"></div>


  <script>
    (function () {
      'use strict';
      var $ = function (s, c) { return (c || document).querySelector(s); };
      var $$ = function (s, c) { return Array.prototype.slice.call((c || document).querySelectorAll(s)); };

      /* ---------- HERO SLIDER: tự lướt phải → trái, lặp vô hạn ---------- */
      var viewport = $('#heroViewport');
      var track = $('#heroTrack');
      var slides = $$('.slide', track);
      var dots = $$('[data-dot]');
      var n = slides.length;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var INTERVAL = 4500;
      var index = 0, timer = null, startX = null;

      // Nhân bản slide đầu và đặt cuối dải để vòng lặp liền mạch
      var clone = slides[0].cloneNode(true);
      clone.setAttribute('aria-hidden', 'true');
      $$('a, button', clone).forEach(function (el) { el.tabIndex = -1; });
      track.appendChild(clone);

      function setX(animate) {
        track.style.transition = (animate && !reduce) ? 'transform 800ms cubic-bezier(.65,0,.35,1)' : 'none';
        track.style.transform = 'translateX(' + (-index * 100) + '%)';
      }
      function paint() {
        var active = index % n;
        dots.forEach(function (d, k) {
          var on = k === active;
          d.setAttribute('aria-current', on ? 'true' : 'false');
          d.firstElementChild.className = 'block h-2.5 rounded-full transition-all duration-300 ' + (on ? 'w-7 bg-ink' : 'w-2.5 bg-ink/30');
        });
      }
      function next() {
        if (reduce) { index = (index + 1) % n; setX(false); paint(); return; }
        index += 1; setX(true); paint();
      }
      function prev() {
        if (index === 0) { index = n; setX(false); track.getBoundingClientRect(); } // nhảy tới bản nhân bản, rồi lùi lại
        index -= 1; setX(true); paint();
      }
      // Khi trượt tới bản nhân bản (= slide đầu) → reset về 0 không hiệu ứng
      track.addEventListener('transitionend', function (e) {
        if (e.target === track && index >= n) { index = 0; setX(false); }
      });

      function play() { if (!reduce && !timer) timer = setInterval(next, INTERVAL); }
      function stop() { clearInterval(timer); timer = null; }

      $('#heroNext').addEventListener('click', function () { next(); });
      $('#heroPrev').addEventListener('click', function () { prev(); });
      dots.forEach(function (d, k) { d.addEventListener('click', function () { index = k; setX(true); paint(); }); });

      viewport.addEventListener('mouseenter', stop);
      viewport.addEventListener('mouseleave', play);
      viewport.addEventListener('focusin', stop);
      viewport.addEventListener('focusout', play);
      document.addEventListener('visibilitychange', function () { document.hidden ? stop() : play(); });

      // Vuốt trên điện thoại
      viewport.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; stop(); }, { passive: true });
      viewport.addEventListener('touchend', function (e) {
        if (startX !== null) {
          var dx = e.changedTouches[0].clientX - startX;
          if (Math.abs(dx) > 50) { dx < 0 ? next() : prev(); }
        }
        startX = null; play();
      }, { passive: true });

      paint(); play();

      /* ---------- GIỎ HÀNG + YÊU THÍCH ---------- */
      var badge = $('#cartCount');
      var toast = $('#toast');
      var count = parseInt(badge.textContent, 10) || 0;
      var toastTimer;

      function showToast(msg) {
        toast.textContent = msg;
        toast.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { toast.classList.remove('show'); }, 2200);
      }

      document.addEventListener('click', function (e) {
        var add = e.target.closest('[data-add]');
        if (add) {
          // PHP: tại đây gọi fetch('add_to_cart.php', {method:'POST', body: ...}) với add.dataset.id
          count += 1;
          badge.textContent = count;
          badge.classList.remove('bump'); void badge.offsetWidth; badge.classList.add('bump');
          showToast('Đã thêm "' + add.dataset.name + '" vào giỏ hàng');
          return;
        }
        var wish = e.target.closest('[data-wish]');
        if (wish) {
          wish.setAttribute('aria-pressed', wish.getAttribute('aria-pressed') !== 'true');
        }
      });
    })();
  </script>
</body>
</html>