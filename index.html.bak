<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Volt Mobile – Điện thoại Apple, Samsung, Xiaomi, OPPO chính hãng</title>
  <meta name="description" content="Mua điện thoại Apple, Samsung, Xiaomi, OPPO chính hãng tại Volt Mobile.">

  <!-- Font: Plus Jakarta Sans (hỗ trợ đầy đủ tiếng Việt) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap&subset=vietnamese" rel="stylesheet">

  <!-- Tailwind CSS qua CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'] },
          colors: {
            ink: '#14142B',
            brand: { DEFAULT: '#5B3DF5', dark: '#4326D6', soft: '#EFEBFF' }
          }
        }
      }
    }
  </script>

  <style>
    html { scroll-behavior: smooth; }
    .no-scrollbar { scrollbar-width: none; }
    .no-scrollbar::-webkit-scrollbar { display: none; }

    /* Nút yêu thích: trạng thái đã chọn */
    [data-wish][aria-pressed="true"] { color: #DC2626; }
    [data-wish][aria-pressed="true"] svg { fill: currentColor; }

    /* Badge giỏ hàng nảy lên khi thêm sản phẩm */
    @keyframes bump { 0% { transform: scale(1); } 40% { transform: scale(1.5); } 100% { transform: scale(1); } }
    .bump { animation: bump .35s ease-out; }

    /* Toast thông báo */
    #toast { transition: opacity .25s ease, transform .25s ease; }
    #toast.show { opacity: 1; transform: translate(-50%, 0); }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      * { transition-duration: .01ms !important; animation-duration: .01ms !important; }
    }
  </style>
</head>

<!--
  =====================================================================
  HƯỚNG DẪN GẮN PHP (tóm tắt)
  ---------------------------------------------------------------------
  1) HEADER ........ khối tĩnh, chỉ thay số lượng giỏ hàng ($cartCount).
  2) HERO SLIDER ... lặp 1 khối .slide cho mỗi banner trong $banners.
                     (JS tự nhân bản slide đầu để lướt vô hạn, KHÔNG cần
                      PHP in thêm slide nhân bản.)
  3) LƯỚI SẢN PHẨM . lặp 1 <section> cho mỗi hãng trong $brands, bên trong
                     lặp 1 <article> cho mỗi sản phẩm của hãng đó.
                     (File mẫu này in sẵn 4 section Apple/Samsung/Xiaomi/OPPO
                      – khi dùng PHP chỉ cần giữ lại 1 section làm khuôn.)
  Dữ liệu trong file là DỮ LIỆU MẪU (tên máy, giá, ảnh minh họa bằng CSS).
  Mỗi vị trí cần đổ dữ liệu đều có comment  PHP: ‹?= $... ?›  (dấu ‹ › chỉ để comment không bị PHP chạy; khi viết thật hãy dùng thẻ PHP chuẩn)
  =====================================================================
-->
<body class="bg-[#FBFBFE] font-sans text-ink antialiased">

  <!-- Bộ icon dùng chung (SVG sprite) – không phải sửa -->
  <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
    <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></symbol>
    <symbol id="i-bag" viewBox="0 0 24 24"><path d="M6 7h12l-1 13H7L6 7Z"/><path d="M9 7a3 3 0 0 1 6 0"/></symbol>
    <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></symbol>
    <symbol id="i-heart" viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z"/></symbol>
    <symbol id="i-left" viewBox="0 0 24 24"><path d="m15 5-7 7 7 7"/></symbol>
    <symbol id="i-right" viewBox="0 0 24 24"><path d="m9 5 7 7-7 7"/></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
    <symbol id="i-bolt" viewBox="0 0 24 24"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></symbol>
  </svg>

  <!-- Link bỏ qua điều hướng (hỗ trợ bàn phím) -->
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-white">Bỏ qua đến nội dung chính</a>

  <!-- ============================================================
       [HEADER – BẮT ĐẦU]
       Logo | Thanh tìm kiếm | Tài khoản + Giỏ hàng | Menu danh mục
       ============================================================ -->
  <header id="site-header" class="sticky top-0 z-50 border-b border-slate-200 bg-white/90 backdrop-blur">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">

      <!-- [HEADER – HÀNG TRÊN BẮT ĐẦU]: logo, tìm kiếm, hành động -->
      <div class="flex flex-wrap items-center gap-x-4 gap-y-3 py-3 md:flex-nowrap md:gap-8">

        <!-- [LOGO – BẮT ĐẦU] -->
        <a href="/" class="order-1 flex items-center gap-2 text-xl font-extrabold tracking-tight" aria-label="Volt Mobile – Trang chủ">
          <span class="grid h-9 w-9 place-items-center rounded-xl bg-brand text-white">
            <svg class="h-5 w-5" fill="currentColor" aria-hidden="true"><use href="#i-bolt"/></svg>
          </span>
          <span>Volt<span class="text-brand">Mobile</span></span>
        </a>
        <!-- [LOGO – KẾT THÚC] -->

        <!-- [TÌM KIẾM – BẮT ĐẦU] PHP: action trỏ tới trang xử lý tìm kiếm, ví dụ search.php -->
        <form action="search.php" method="get" role="search" class="order-3 w-full md:order-2 md:flex-1">
          <label for="q" class="sr-only">Tìm kiếm sản phẩm</label>
          <div class="relative mx-auto max-w-2xl">
            <svg class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-search"/></svg>
            <input id="q" name="q" type="search" placeholder="Tìm iPhone, Galaxy, Xiaomi, OPPO…" autocomplete="off"
                   class="h-12 w-full rounded-full border border-slate-200 bg-slate-100 pl-12 pr-28 text-sm font-medium placeholder:text-slate-500 transition focus:border-brand focus:bg-white focus:outline-none focus:ring-4 focus:ring-brand/15">
            <button type="submit" class="absolute right-1.5 top-1/2 h-9 -translate-y-1/2 rounded-full bg-brand px-5 text-sm font-bold text-white transition hover:bg-brand-dark">Tìm</button>
          </div>
        </form>
        <!-- [TÌM KIẾM – KẾT THÚC] -->

        <!-- [HÀNH ĐỘNG – BẮT ĐẦU]: tài khoản + giỏ hàng -->
        <div class="order-2 ml-auto flex items-center gap-1 md:order-3 md:ml-0">
          <a href="account.php" class="grid h-11 w-11 place-items-center rounded-full text-slate-700 transition hover:bg-brand-soft hover:text-brand" aria-label="Tài khoản">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-user"/></svg>
          </a>
          <a href="cart.php" class="relative grid h-11 w-11 place-items-center rounded-full text-slate-700 transition hover:bg-brand-soft hover:text-brand" aria-label="Giỏ hàng">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-bag"/></svg>
            <!-- PHP: ‹?= (int)$cartCount ?› -->
            <span id="cartCount" class="absolute right-0 top-0 grid h-5 min-w-5 place-items-center rounded-full bg-red-600 px-1 text-[11px] font-bold leading-none text-white">0</span>
          </a>
        </div>
        <!-- [HÀNH ĐỘNG – KẾT THÚC] -->

      </div>
      <!-- [HEADER – HÀNG TRÊN KẾT THÚC] -->

      <!-- [MENU DANH MỤC – BẮT ĐẦU]
           PHP: foreach ($brands as $brand): ... <li> ... endforeach;  -->
      <nav aria-label="Danh mục sản phẩm" class="-mx-4 overflow-x-auto px-4 pb-3 no-scrollbar sm:-mx-6 sm:px-6">
        <ul class="flex min-w-max items-center gap-2">
          <li><a href="#hero" class="inline-flex h-10 items-center rounded-full bg-ink px-4 text-sm font-semibold text-white">Flagship</a></li>
          <!-- PHP LOOP BẮT ĐẦU: foreach ($brands as $brand): -->
          <!-- PHP: href="#‹?= $brand['slug'] ?›" – ‹?= $brand['name'] ?› -->
          <li><a href="#apple" class="inline-flex h-10 items-center rounded-full px-4 text-sm font-semibold text-slate-700 transition hover:bg-brand-soft hover:text-brand">Apple</a></li>
          <!-- PHP: href="#‹?= $brand['slug'] ?›" – ‹?= $brand['name'] ?› -->
          <li><a href="#samsung" class="inline-flex h-10 items-center rounded-full px-4 text-sm font-semibold text-slate-700 transition hover:bg-brand-soft hover:text-brand">Samsung</a></li>
          <!-- PHP: href="#‹?= $brand['slug'] ?›" – ‹?= $brand['name'] ?› -->
          <li><a href="#xiaomi" class="inline-flex h-10 items-center rounded-full px-4 text-sm font-semibold text-slate-700 transition hover:bg-brand-soft hover:text-brand">Xiaomi</a></li>
          <!-- PHP: href="#‹?= $brand['slug'] ?›" – ‹?= $brand['name'] ?› -->
          <li><a href="#oppo" class="inline-flex h-10 items-center rounded-full px-4 text-sm font-semibold text-slate-700 transition hover:bg-brand-soft hover:text-brand">OPPO</a></li>
          <!-- PHP LOOP KẾT THÚC: endforeach; -->
        </ul>
      </nav>
      <!-- [MENU DANH MỤC – KẾT THÚC] -->

    </div>
  </header>
  <!-- [HEADER – KẾT THÚC] -->


  <main id="main">

    <!-- ============================================================
         [BANNER HERO SLIDER – BẮT ĐẦU]
         Tự động lướt từ PHẢI sang TRÁI, lặp vô hạn (xem JS cuối file)
         ============================================================ -->
    <section id="hero" class="mx-auto max-w-7xl px-4 pt-4 sm:px-6 sm:pt-6" aria-roledescription="carousel" aria-label="Sản phẩm flagship nổi bật">

      <!-- [VIEWPORT – BẮT ĐẦU]: khung cắt phần tràn, bo góc mềm -->
      <div id="heroViewport" class="relative overflow-hidden rounded-[1.75rem] sm:rounded-[2rem]">

        <!-- [TRACK – BẮT ĐẦU]: dải ngang chứa các slide, JS dịch chuyển bằng translateX -->
        <div id="heroTrack" class="flex will-change-transform">

          <!-- PHP LOOP BẮT ĐẦU: foreach ($banners as $i => $banner):
               Mỗi vòng lặp in ra 1 khối .slide bên dưới -->
          <!-- [SLIDE 1 – BẮT ĐẦU] PHP: class màu nền = ‹?= $banner['bg_class'] ?› -->
          <article class="slide bg-ink text-white w-full shrink-0 grow-0 basis-full" role="group" aria-roledescription="slide" aria-label="1 / 4">
            <div class="grid min-h-[34rem] items-center gap-4 px-6 pb-24 pt-10 sm:px-12 md:min-h-[30rem] md:grid-cols-2 md:gap-8 md:px-16 md:py-14 md:pb-20">

              <!-- [SLIDE – CỘT CHỮ BẮT ĐẦU] -->
              <div class="relative z-10">
                <!-- PHP: ‹?= $banner['eyebrow'] ?› -->
                <span class="inline-flex items-center rounded-full bg-white/15 text-white px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider">Apple · Flagship</span>
                <!-- PHP: ‹?= $banner['title'] ?› -->
                <h2 class="mt-5 text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">iPhone 18 Pro Max</h2>
                <!-- PHP: ‹?= $banner['text'] ?› -->
                <p class="mt-4 max-w-md text-base font-medium leading-relaxed opacity-90 sm:text-lg">Dòng flagship cao cấp nhất của Apple, dành cho người dùng chuyên nghiệp.</p>
                <!-- PHP: href="‹?= $banner['link'] ?›" -->
                <a href="#apple" class="mt-8 inline-flex h-12 items-center gap-2 rounded-full bg-white text-ink hover:bg-brand-soft px-7 text-sm font-bold transition hover:-translate-y-0.5 active:scale-95">
                  Xem Apple
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#i-right"/></svg>
                </a>
              </div>
              <!-- [SLIDE – CỘT CHỮ KẾT THÚC] -->

              <!-- [SLIDE – CỘT ẢNH BẮT ĐẦU] PHP: thay 2 điện thoại CSS bằng <img src="‹?= $banner['image'] ?›" alt=""> -->
              <div class="relative flex h-64 items-center justify-center gap-0 sm:h-80 md:h-96" aria-hidden="true">
                <div aria-hidden="true" class="relative aspect-[9/19] w-32 sm:w-40 md:w-48 rounded-[14%/6.6%] shadow-xl ring-1 ring-black/10 -rotate-6 translate-y-3 -mr-6" style="background-color: #E59A6B">
            <div class="absolute left-[9%] top-[5%] grid aspect-square w-[46%] grid-cols-2 content-between gap-[10%] rounded-[28%] bg-black/25 p-[8%]">
              <span class="aspect-square rounded-full bg-neutral-900 ring-2 ring-white/25"></span>
              <span class="aspect-square rounded-full bg-neutral-900 ring-2 ring-white/25"></span>
              <span class="aspect-square rounded-full bg-neutral-900 ring-2 ring-white/25"></span>
            </div>
          </div>
                <div aria-hidden="true" class="relative aspect-[9/19] w-32 sm:w-40 md:w-48 rounded-[14%/6.6%] shadow-xl ring-1 ring-black/10 rotate-6 -translate-y-3" style="background-color: #3B4A63">
            <div class="absolute left-[9%] top-[5%] grid aspect-square w-[46%] grid-cols-2 content-between gap-[10%] rounded-[28%] bg-black/25 p-[8%]">
              <span class="aspect-square rounded-full bg-neutral-900 ring-2 ring-white/25"></span>
