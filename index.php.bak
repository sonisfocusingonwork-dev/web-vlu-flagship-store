<?php include 'db.php'; // Nhúng file kết nối CSDL ?>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cửa Hàng Điện Tử</title>
    <style>
        body { font-family: Arial, sans-serif; padding: 20px; }
        .product-card { 
            border: 1px solid #ccc; padding: 15px; margin: 10px; 
            width: 250px; display: inline-block; border-radius: 8px;
        }
        .price { color: red; font-weight: bold; }
        button { padding: 10px; background: #007bff; color: white; border: none; cursor: pointer; }
    </style>
</head>
<body>
    <h1>Danh sách Điện thoại nổi bật</h1>
    
    <div class="product-list">
        <?php
        $sql = "SELECT * FROM products";
        $stmt = $conn->query($sql);

        while ($row = $stmt->fetch(PDO::FETCH_ASSOC)) {
            echo "<div class='product-card'>";
            echo "<h3>" . htmlspecialchars($row['name']) . "</h3>";
            echo "<p class='price'>" . number_format($row['price'], 0, ',', '.') . " VNĐ</p>";
            echo "<p>" . htmlspecialchars($row['description']) . "</p>";
            echo "<button>Thêm vào giỏ</button>";
            echo "</div>";
        }
        ?>
    </div>
</body>
</html>