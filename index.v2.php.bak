  <style>
    html { scroll-behavior: smooth; }
    .no-scrollbar { scrollbar-width: none; }
    .no-scrollbar::-webkit-scrollbar { display: none; }

    /* Nút yêu thích: trạng thái đã chọn */
    [data-wish][aria-pressed="true"] { color: #DC2626; }
    [data-wish][aria-pressed="true"] svg { fill: currentColor; }

    /* Badge giỏ hàng nảy lên khi thêm sản phẩm */
    @keyframes bump { 0% { transform: scale(1); } 40% { transform: scale(1.5); } 100% { transform: scale(1); } }
    .bump { animation: bump .35s ease-out; }

    /* Toast thông báo */
    #toast { transition: opacity .25s ease, transform .25s ease; }
    #toast.show { opacity: 1; transform: translate(-50%, 0); }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      * { transition-duration: .01ms !important; animation-duration: .01ms !important; }
    }

    /* === THẺ SẢN PHẨM (.product-card) CHUẨN APPLE STORE x SHOPIFY === */
    .product-card {
      position: relative;
      display: flex;
      flex-direction: column;
      border-radius: 24px; /* Bo góc 24px theo đúng yêu cầu */
      background: #ffffff; /* Nền sáng tinh tế */
      border: 1px solid rgba(226, 232, 240, 0.8);
      padding: 1.25rem;
      box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05); /* Hiệu ứng đổ bóng nhẹ */
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .product-card:hover {
      transform: translateY(-6px);
      border-color: rgba(91, 61, 245, 0.35);
      box-shadow: 0 16px 32px -4px rgba(0, 0, 0, 0.1), 0 4px 12px -2px rgba(91, 61, 245, 0.08);
    }

    /* Khung ảnh sản phẩm tỷ lệ 680x528 chuẩn Apple Card */
    .product-img-box {
      aspect-ratio: 680 / 528; /* Tỷ lệ ảnh chuẩn 680x528 */
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      border-radius: 18px;
      padding: 0.75rem;
      transition: background-color 0.3s ease;
    }
    .product-card:hover .product-img-box {
      background-color: #f3f4f6;
    }

    /* Ảnh sản phẩm: hiển thị trực tiếp từ cột $row['image'], object-fit contain */
    .product-img {
      max-height: 100%;
      max-width: 100%;
      width: auto;
      height: auto;
      object-fit: contain;
      filter: drop-shadow(0 6px 16px rgba(0, 0, 0, 0.06));
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), filter 0.5s ease;
    }
    .product-card:hover .product-img {
      transform: scale(1.06);
      filter: drop-shadow(0 14px 24px rgba(0, 0, 0, 0.12));
    }

    /* Khung banner hero trượt ngang */
    .banner-img-wrap {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      height: 16rem;
      padding: 1rem;
    }
    @media (min-width: 640px) { .banner-img-wrap { height: 20rem; } }
    @media (min-width: 768px) { .banner-img-wrap { height: 24rem; } }
    @media (min-width: 1024px) { .banner-img-wrap { height: 28rem; } }
    
    .banner-img {
      position: relative;
      z-index: 10;
      max-height: 100%;
      max-width: 100%;
      width: auto;
      height: auto;
      object-fit: contain;
      border-radius: 1rem;
      filter: drop-shadow(0 20px 35px rgba(0, 0, 0, 0.45));
      transition: transform 0.6s ease;
    }
    .banner-img:hover {
      transform: scale(1.04);
    }
  </style>
</head>

