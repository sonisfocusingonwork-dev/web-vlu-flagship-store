// Nếu CSDL MySQL có dữ liệu sản phẩm, đồng bộ trực tiếp từ các cột trong bảng products
if ($db_connected && !empty($db_products)) {
    $db_by_brand = [
        'apple' => [],
        'samsung' => [],
        'xiaomi' => [],
        'oppo' => []
    ];
    
    foreach ($db_products as $row) {
        $catId = (int)($row['category_id'] ?? 0);
        $nameLower = strtolower($row['name'] ?? '');
        $brandKey = null;
        if ($catId === 1 || strpos($nameLower, 'iphone') !== false || strpos($nameLower, 'apple') !== false) {
            $brandKey = 'apple';
        } elseif ($catId === 2 || strpos($nameLower, 'galaxy') !== false || strpos($nameLower, 'samsung') !== false) {
            $brandKey = 'samsung';
        } elseif ($catId === 3 || strpos($nameLower, 'xiaomi') !== false || strpos($nameLower, 'redmi') !== false) {
            $brandKey = 'xiaomi';
        } elseif ($catId === 4 || strpos($nameLower, 'oppo') !== false || strpos($nameLower, 'find') !== false) {
            $brandKey = 'oppo';
        }
        
        if ($brandKey && !empty($row['image'])) {
            $db_by_brand[$brandKey][] = [
                'id' => (int)($row['id'] ?? 0),
                'name' => $row['name'] ?? '',
                'description' => $row['description'] ?? '',
                'variant' => 'Chính Hãng Flagship',
                'price' => (float)($row['price'] ?? 0),
                'old_price' => !empty($row['old_price']) ? (float)$row['old_price'] : null,
                'badge' => $row['badge'] ?? ($brandKey === 'apple' ? 'Apple Store' : 'Chính Hãng'),
                'badge_class' => 'bg-slate-900 text-white',
                'image' => $row['image'] ?? ''
            ];
        }
    }
    
    // Nếu có sản phẩm trong DB cho hãng đó thì ưu tiên hiển thị từ CSDL
    foreach ($db_by_brand as $bKey => $pList) {
        if (!empty($pList)) {
            $brands[$bKey]['products'] = $pList;
        }
    }
}

$cartCount = 0;
