// Bọc bộ nhớ đệm để bắt các lỗi echo thô nếu CSDL MySQL chưa bật
ob_start();
@include_once 'db.php';
$db_init_msg = ob_get_clean();

$db_connected = false;
$db_products = [];

if (isset($conn) && $conn instanceof PDO) {
    try {
        $stmt = $conn->query("SELECT * FROM products ORDER BY id ASC");
        if ($stmt) {
            $rows = $stmt->fetchAll(PDO::FETCH_ASSOC);
            if (!empty($rows)) {
                $db_products = $rows;
                $db_connected = true;
            }
        }
    } catch (Exception $e) {
        $db_connected = false;
    }
}

