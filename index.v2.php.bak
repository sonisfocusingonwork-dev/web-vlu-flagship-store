    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'] },
          colors: {
            ink: '#0B0F19',
            brand: { DEFAULT: '#5B3DF5', dark: '#4326D6', soft: '#EFEBFF' }
