  <!-- Toast thông báo -->
  <div id="toast" role="status" aria-live="polite" class="pointer-events-none fixed bottom-6 left-1/2 z-50 -translate-x-1/2 translate-y-4 rounded-full bg-ink px-5 py-3 text-sm font-semibold text-white shadow-xl opacity-0"></div>

  <!-- JavaScript cho Slider & Giỏ hàng -->
  <script>
    (function () {
      'use strict';
      var $ = function (s, el) { return (el || document).querySelector(s); };
      var $$ = function (s, el) { return (el || document).querySelectorAll(s); };

      /* ---------- HERO SLIDER TRƯỢT VÔ HẠN ---------- */
      var viewport = $('#heroViewport');
      var track    = $('#heroTrack');
      var slides   = $$('.slide', track);
      var dots     = $$('[data-dot]');
      var n        = slides.length;
      if (!viewport || !track || n === 0) return;

      var firstClone = slides[0].cloneNode(true);
      firstClone.setAttribute('aria-hidden', 'true');
      firstClone.removeAttribute('role');
      firstClone.removeAttribute('aria-roledescription');
      firstClone.removeAttribute('aria-label');
      track.appendChild(firstClone);

      var index = 0;
      var timer = null;
      var INTERVAL = 5000;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var startX = null;

      function setX(animate) {
        track.style.transitionProperty = animate ? 'transform' : 'none';
        track.style.transform = 'translate3d(' + (-index * 100) + '%,0,0)';
      }
      function paint() {
        var active = index >= n ? 0 : index;
        dots.forEach(function (d, k) {
          var on = k === active;
          d.setAttribute('aria-current', on ? 'true' : 'false');
          var bar = d.firstElementChild;
          if (bar) {
            bar.className = 'block h-2.5 rounded-full transition-all duration-300 ' +
              (on ? 'w-7 bg-ink' : 'w-2.5 bg-ink/30');
          }
        });
      }
      function next() {
        index += 1; setX(true); paint();
      }
      function prev() {
        if (index === 0) { index = n; setX(false); track.getBoundingClientRect(); }
        index -= 1; setX(true); paint();
      }
      track.addEventListener('transitionend', function (e) {
        if (e.target === track && index >= n) { index = 0; setX(false); }
      });

      function play() { if (!reduce && !timer) timer = setInterval(next, INTERVAL); }
      function stop() { clearInterval(timer); timer = null; }

      $('#heroNext').addEventListener('click', function () { next(); });
      $('#heroPrev').addEventListener('click', function () { prev(); });
      dots.forEach(function (d, k) { d.addEventListener('click', function () { index = k; setX(true); paint(); }); });

      viewport.addEventListener('mouseenter', stop);
      viewport.addEventListener('mouseleave', play);
      viewport.addEventListener('focusin', stop);
      viewport.addEventListener('focusout', play);
      document.addEventListener('visibilitychange', function () { document.hidden ? stop() : play(); });

      viewport.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; stop(); }, { passive: true });
      viewport.addEventListener('touchend', function (e) {
        if (startX !== null) {
          var dx = e.changedTouches[0].clientX - startX;
          if (Math.abs(dx) > 50) { dx < 0 ? next() : prev(); }
        }
        startX = null; play();
      }, { passive: true });

      paint(); play();

      /* ---------- GIỎ HÀNG + YÊU THÍCH ---------- */
      var badge = $('#cartCount');
      var toast = $('#toast');
      var count = parseInt(badge.textContent, 10) || 0;
      var toastTimer;

      function showToast(msg) {
        toast.textContent = msg;
        toast.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { toast.classList.remove('show'); }, 2200);
      }

      document.addEventListener('click', function (e) {
        var add = e.target.closest('[data-add]');
        if (add) {
          count += 1;
          badge.textContent = count;
          badge.classList.remove('bump'); void badge.offsetWidth; badge.classList.add('bump');
          showToast('Đã thêm "' + add.dataset.name + '" vào giỏ hàng');
          return;
        }
        var wish = e.target.closest('[data-wish]');
        if (wish) {
          wish.setAttribute('aria-pressed', wish.getAttribute('aria-pressed') !== 'true');
        }
      });
    })();
  </script>
</body>
</html>
